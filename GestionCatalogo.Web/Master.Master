<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.Master.cs" Inherits="GestionCatalogo.Web.Master" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GestiónCatalogo</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; }
        body { background: #f4f6f9; color: #222; min-height: 100vh; }

        nav.topbar { background: #2c3e50; color: #fff; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 58px; box-shadow: 0 2px 6px rgba(0,0,0,.25); position: sticky; top: 0; z-index: 10; }
        nav.topbar .brand { font-size: 1.25rem; font-weight: bold; color: #fff; text-decoration: none; letter-spacing: .5px; }
        nav.topbar .links a { color: #dfe6ef; text-decoration: none; margin-left: 18px; padding: 8px 12px; border-radius: 6px; transition: background .15s; }
        nav.topbar .links a:hover, nav.topbar .links a.actual { background: #34495e; color: #fff; }
        nav.topbar .links a.admin { color: #f9c74f; font-weight: 600; }
        nav.topbar .user-chip { color:#aab7c4; font-size: .85rem; margin-left: 16px; }

        main.contenido { max-width: 1200px; margin: 0 auto; padding: 28px 24px 60px; }

        .fichero-grid { display: flex; flex-wrap: wrap; gap: 20px; }
        .tarjeta { background: #fff; border: 1px solid #e3e8ee; border-radius: 12px; padding: 14px; width: 270px; display: flex; flex-direction: column; transition: transform .12s, box-shadow .12s; }
        .tarjeta:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,.10); }
        .tarjeta img.portada { width: 100%; height: 150px; object-fit: cover; border-radius: 8px; background: #eef2f6; }
        .tarjeta h3 { font-size: 1.05rem; margin: 10px 0 4px; color: #2c3e50; }
        .tarjeta .desc { font-size: .86rem; color: #6b7684; flex: 1; min-height: 34px; }
        .tarjeta .meta { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
        .tarjeta .precio { font-weight: 700; color: #1d8348; font-size: 1.05rem; }
        .tarjeta .chips span { display: inline-block; background: #eef2f6; color: #54657c; border-radius: 10px; font-size: .72rem; padding: 2px 8px; margin-right: 4px; }
        a.boton, button.boton { display: inline-block; background: #3498db; color: #fff; border: none; border-radius: 8px; padding: 9px 18px; font-size: .92rem; text-decoration: none; cursor: pointer; text-align: center; }
        a.boton:hover, button.boton:hover { background: #2980b9; }
        button.boton.rojo { background: #e74c3c; }
        button.boton.rojo:hover { background: #c0392b; }
        button.boton.fav { background: #f1c40f; color: #7d6608; }
        button.boton.fav:hover { background: #d4ac0d; }

        .formularios { max-width: 460px; margin: 30px auto 0; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 26px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .formularios h2 { color: #1f2937; margin-bottom: 18px; font-weight: 600; }
        .formularios label { display: block; font-size: .87rem; color: #4b5563; margin: 12px 0 4px; font-weight: 500; }
        .formularios input[type=text], .formularios input[type=password], .formularios input[type=email], .formularios select, .formularios textarea { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .95rem; transition: border-color 0.2s; }
        .formularios input:focus { border-color: #4f46e5; outline: none; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); }
        .formularios input.error { border-color: #ef4444; }
        .formularios .error-texto { color: #ef4444; font-size: .8rem; margin-top: 3px; }
        .formularios .mensaje-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; padding: 12px 16px; border-radius: 8px; margin-bottom: 18px; }

        .tabla-grilla { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; }
        .tabla-grilla th { background: #2c3e50; color: #fff; padding: 10px 12px; text-align: left; font-size: .9rem; }
        .tabla-grilla td { padding: 9px 12px; border-bottom: 1px solid #eef2f6; font-size: .9rem; }
        .tabla-grilla tr:hover td { background: #f8fafc; }
        .tabla-grilla img.mini { width: 52px; height: 40px; object-fit: cover; border-radius: 4px; }

        .mensaje-error { background: #fdecea; color: #b03a2e; border: 1px solid #f5b7b1; padding: 12px 16px; border-radius: 8px; margin-bottom: 18px; }

        footer.pie { background: #2c3e50; color: #95a5a6; text-align: center; padding: 18px; font-size: .8rem; margin-top: 40px; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="topbar">
            <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>">🛒 GestiónCatalogo</a>
            <div class="links">
                <a href="<%= ResolveUrl("~/Default.aspx") %>">Catálogo</a>
                <% if (Usuario != null && Usuario.Admin) { %>
                    <a href="<%= ResolveUrl("~/admin/PanelArticulos.aspx") %>" class="admin">Administración</a>
                    <span style="color:#aab7c4; font-size:.82rem; margin-left:8px;">(<%= ArticulosCount %> artículos)</span>
                <% } %>
                <% if (Usuario != null) { %>
                    <a href="<%= ResolveUrl("~/Favoritos.aspx") %>">Mis favoritos</a>
                    <a href="<%= ResolveUrl("~/MiPerfil.aspx") %>">Mi Perfil</a>
                    <asp:LinkButton ID="btnSalir" runat="server" OnClick="btnSalir_Click">Cerrar sesión</asp:LinkButton>
                <% } else { %>
                    <a href="Login.aspx">Ingresar</a>
                <% } %>
                <span class="user-chip"><%: Usuario != null ? Usuario.Email : "" %></span>
            </div>
        </nav>

        <main class="contenido">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="pie">
            TP Integrador Nivel 3 — Gabriel Blanco · GestiónCatalogo
        </footer>
    </form>
</body>
</html>
